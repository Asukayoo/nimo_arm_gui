<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nimo_arm_bringup</name>
  <version>0.1.0</version>
  <description>Launch files for Nimo arm HMI (backend + RSP + RViz + GUI).</description>
  <maintainer email="dev@nimotechs.com">nimo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime packages differ by machine: local uses gui+description; nimo uses nimo_arm_ros. -->
  <exec_depend>nimo_arm_description</exec_depend>
  <exec_depend>nimo_arm_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
