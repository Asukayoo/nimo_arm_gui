# Start recording executed joint trajectory (resp_q). Not status Record*.
# path:
#   empty              → <traj_dir>/traj_<epoch>.traj
#   basename / relative → <traj_dir>/<name>.traj  (.traj 可省略)
#   absolute path      → as given
string path
# Sample period [s]; <=0 uses default (0.02)
float64 sample_period
---
bool success
string message
string path
